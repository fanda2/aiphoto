.concern{
  padding-top: 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  justify-items: center;
}

/* 内容样式 */
.container-layout
{
 margin-top:9%;
 width: 100%;
 height: 100%;
}
.banner{
  /* height:160rpx;  */
  width:100%;
  display: flex;
  display: -webkit-box;
  flex-direction: column;
} 
.banner_Item{ 
 width:100%;
 height:auto;
 background-color:rgb(243, 243, 243);
 margin-right:10rpx;
 display: flex;
 flex-direction: column;
 justify-items: center;
 justify-content: center;
} 

.slide-image{
   height: auto;
  width: 100%;
}

/* 文章内容 */
.container-text{
  width: 92%;
  margin: 5px auto;
}
.title{
  height: 10%;
  font-size: 36rpx;
  font-weight: 600;
}
.essay{
  height: 70%;
  line-height:58rpx;
  letter-spacing:3rpx;
  margin-top:20rpx
}
.divLine
{
  margin: 3px;
  background: #d6d6d6;
  width: 100%;
  height: 5rpx;
}
.container{
  height:35vh;
  padding-top: 0px;
}
.vol-swiper-item {
  margin-top: 20rpx;
  box-sizing: border-box;
}
 
.vol-card {
  /*parent layout  and  this inner padding*/
  /* padding: 6rpx; */
  height: 100%;
  background: url('http://aiphoto.fjtbkyc.top/load.gif') navajowhite center center;
}
.vol-swiper {
  height: auto;
}
 
/* 作者信息 */
.author{
  width: 100%;
  height: 100px;
  margin: 0 auto;
  background: rgb(158, 218, 253);
  border-radius: 4px;
  box-shadow: 2px 2px 2px rgb(223, 223, 223);
}
.author_top{
  display: flex;
}
.sex image{
  width: 25px;
  height: 25px;
  padding: 5px;
}
.atop_left image{
  width: 60px;
  height: 60px;
  border-radius: 8px;
  margin: 5px;
}
.atop_center{
  margin: 5px;
  width: 50%;
}
.atop_right{
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;

}
.follow_text{
  width: 80px;
  text-align: center;
  line-height: 30px;
  color: #4b4b4b;
  background: rgb(238, 144, 20);
  border-radius: 20px;
}
/* 关注状态，活跃 */
.follow-active{
  background: #61d46a;
  color: white;
}
.author_bottom{
  width: 60%;
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  padding:0 5px;
  box-sizing: border-box;
}
.author_bottom text{
  margin-left: 5px;

}
.author_tottom view{
  width: 20%;
}



.vol-picture {
  width: 100%;
  height: 100%;
}
.tabel{
  margin: 10rpx;
  width: auto;
  height: 100rpx;
  display: flex;
  display: -webkit-box;
  flex-direction: column;
}
.tabeltext{
  background: rgb(140, 202, 238,0.6);
  height: 60rpx;
  font-size: 24rpx;
  margin:20rpx 30rpx 0 0;
  line-height: 60rpx;
  text-align: center;
  border-radius: 20rpx;
}
.tabeltext view{
  margin:0 10px 0 10px;
}
.bannerNum {
  width: 120rpx;
  height: 50rpx;
  border-radius: 20rpx;
  line-height: 50rpx;
  text-align: center;
  position: absolute;
  right: 10rpx;
  top: 30%;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 26rpx;
  
}
.article_data{
  height: 50rpx;
  line-height: 50rpx;
  margin-top: 100rpx;
  text-align: center;
  font-size: 28rpx;
  /* float: left; */
}
.article_data text{
  float: left;
}

.article_local{
  height: 50rpx;
  line-height: 50rpx;
  font-size: 28rpx;
}
.empty{
  height:100rpx;
  /* background-color: chartreuse; */
}
.empty1{
  height:210rpx;
  /* background-color: chartreuse; */
}
.map_api{
  color: #61cdff;
  text-decoration: underline;
}
.bottom_line{
  width: 92%;
  height: 40px;
  line-height: 40px;
 padding-left:10px ;
  margin: 0 auto;
  border-top:1px black solid;
}
.in_content{
  height: 90%;
}
.content{
  width: 100%;
  /* height: 180px; */
  /* background: #fb9527; */

}
::-webkit-scrollbar{
width: 0;
height: 0;
color: transparent;
}

.content_top{
  width: 100%;
  display: flex;
  margin-top:5px;
  padding: 5px;
  border-bottom: #dbdbdb 1px solid;

}
.left_avatar{
  width: 16%;
  /* background: red; */
}
.avatarurl{
  margin: 20rpx;
  width: 70rpx;
  height: 70rpx;
  overflow: hidden;
  border-radius: 50%;
  /* background: pink; */
}
.right_content{
  width: 80%;
}
.left_avatar image{
  width: 70rpx;
  height: 70rpx;
}
.right_nickname{
  /* background: purple; */
  width: 100%;
  height: 100rpx;
  margin-left: 5px;
}
.nickname{
  padding-top: 10rpx;
  font-size:large;
}
.time{
  font-size:small
}
.content_mid{
  width: 100%;
  /* background: palegreen; */
  margin-left: 5px;
  padding-top: 5px;
}
.content_bottom{
  width: 96%;
  margin-left: 5px;
  margin-top: 5px;
  padding: 5px;
  font-size: smaller;
  height: 80px;
  background: rgb(221, 221, 221);
  overflow: hidden;
  border-radius: 4px;
}
.content_bottom text
{
  font-weight: bold;
  color:  #fb9527;
}
.bottom_line .total{
  color: dimgray;
}
.in_btn{
  margin-top: 5px;
  width:20%;
  text-align: center;
  color: #fb9527;
}
.bottom{
  width: 85%;
  margin: 0 auto;
  color: #000000;
  display: flex;
  justify-content: space-between;
}

.like{
  display: flex;
  flex-direction: column;
  justify-items: center;
  justify-content: center;
  width: 20%;

}
.inlike{
  padding-top: 8px;
  display: flex;
}
.inlike image{
  width: 60rpx;
  height: 60rpx;
}
.boconcern{
  margin-left: 60rpx;
  display: flex;
  flex-direction: column;
  justify-items: center;
  justify-content: center;
  width: 20%;
}
.inbconcern{
  display: flex;
}
.inbconcern image{
  padding-top: 8px;
  width: 60rpx;
  height: 60rpx;
}
.likeimg{
  width: 60rpx;
  height: 60rpx;
  /* background: #fb9527; */
}


.share{
  display: flex;
  width: 20%;
}
.shareimg{
  width: 60rpx;
  height: 60rpx;
}
.shareimg image{
  width: 60rpx;
  height: 60rpx;
}
.bbbox{
  position: fixed;
  bottom: 0;
  height: 150rpx;
  width: 100%;
  background-color: rgb(255, 255, 255);
  box-shadow:-3rpx -3rpx 4px #e0e0e0 ;
  display: flex;
  flex-direction: column;
  justify-items: center;
  justify-content: center;
}
.liketext{
  font-size: 24rpx;
}
.context{
  font-size: 24rpx;
}
.active{
  border: rgb(219, 219, 219) 0rpx solid;
  background: #fb9527;
}
.allmessage{
  margin-left: 5px;
  padding-top:11px ;
  width: 62%;
  display: flex;
  justify-content: space-between;
}
.btn1{
  width: 80rpx;
  height: 80rpx;
  background-color: rgb(255, 255, 255);
  color: #ffffff;
  border-radius: 0rpx;
}

.btnImg {
  width: 60rpx;
  height: 60rpx;
}
.btn1::after {
  background: rgb(248, 248, 248);
  border: 0; 
}
