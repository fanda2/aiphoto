page{
  background: #f3f3f3;
}
.navbar {
  position: fixed;
  z-index: 99;
  top: 0;
  flex: none;
  width: 100%;
  display: flex;
  line-height: 45px;
  justify-content: center;
  background: white;
  font-size: 16px;
  border-bottom: black 1px solid;
}
.navbar_txtable{
  width: 92%;
  height: 100%;
}

.navbar_tabel{
  width: auto;
  height: 80rpx;
  display: flex;
  display: -webkit-box;
  flex-direction: column;
}

.item{
  font-size: 16px;
  margin: 5px;
  margin:0 10px 0 10px;
  width: 50px;
  height: 35px;
  line-height: 35px;
  text-align: center;
}
.active {
  color: #fb9527;
  border-bottom: #fb9527 8px solid;
}

.navbar .activeL {
  width: 110px;
  height: 35px;
  line-height: 35px;
  text-align: center;
  color: white;
  background: #fb9527;
  border-radius: 25px 0 0 25px;
  border: #fb9527 2px solid;
  /* background-size: 100px 40px; */
}

.navbar .activeR {
  width: 110px;
  height: 35px;
  line-height: 35px;
  text-align: center;
  color: white;
  background: #fb9527;
  border-radius: 0 25px 25px 0;
  border: #fb9527 2px solid;
}

/* 文章列表 */
.articleList {
  width: 98%;
  margin: 0 auto;
  background-color: white;
  border-radius: 10px;
  font-size: 13px;
}

.empty_tab {
  width: 100%;
}

.text-item {
  width: 50%;
  height: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  /* background: chartreuse; */
  /* justify-content: center; */
}

/* 文章内容样式 */
.article-item {
  /* margin: 4px; */
  width: 96%;
  margin-top: 18px;
  background: rgb(240, 240, 240);
  box-shadow: 2px 2px 2px #cccccc;
  border-radius: 10px;
}


.myimg {
  width: 100%;
  height: auto;
  border-radius: 10px;
  background: url('http://aiphoto.fjtbkyc.top/load.gif');
  background-size: cover;
}

.article_local {
  width: 94%;
  margin: 0 auto;
  display: flex;

}

.myimg image {
  width: 100%;
  height: 200px;
  border-radius: 10px;
  display: block;
}

.mytitle {
  width: 94%;
  margin: 5rpx auto;
  font-size: 28rpx;
  font-weight: 600;
  font-family: "楷体";
  /* 显示两行，其余省略号 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.myhand {
  width: 20%;
  /* padding:1%; */
  height: 30px;
  width: 30px;
  border-radius: 15px;
  /* background: chartreuse; */
}

.myhand image {
  height: 30px;
  width: 30px;
  border-radius: 50%;
}

.myname {
  margin-left: 5px;
  width: 70%;
  height: 30px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 30px;
  font-size: 24rpx;
}


.container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-start;
  /* justify-content:flex-start; */
  margin-top: 40px;
  padding-bottom: 20px;
}

.conterL {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 50%;
  margin: 0 auto;
  /* background: chartreuse; */
}

.conterR {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 50%;
  margin: 10px auto;
}

.conter {
  width: 100%;
  height: 100%;
  line-height: 400px;
  padding-top: 30rpx;
  text-align: center;

}

.artile-local{
  padding: 5rpx 10rpx;
}

.local_img image {
  width: 30rpx;
  height: 30rpx;
  float: left;
  /* position: relative;
  bottom:40px; */
  /* z-index: 12; */
}

.arcicle-local_in {
  /* height: 30rpx; */
  display: flex;
  font-size: 18rpx;
  color: rgb(75, 75, 75);
  width: 98%;
  letter-spacing: 3rpx;
  font-weight: 550;
  border-radius: 10px;
}

.local_name {
  width: auto;
  /* height: auto; */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* white-space: pre-line; */
}

.inlocal_name {
  width: 100%;
  height: 25rpx;
  display: block;
  white-space: pre-line;
  overflow: hidden; 
  /* height: auto;
  /* white-space: pre-line; */
  text-overflow: ellipsis;
  /* 当文本溢出包含元素时显示省略符号来代表被修剪的文本   */

}
.nofund{
  width: 100%;
  height: 120px;
}
.nofund image{
width: 150px;
height: 100px;

}
.list-bottom{
  width: 100%;
  height: 50rpx;
  line-height: 50rpx;
  background: rgb(240, 240, 240);
  text-align: center;
  font-size: 24rpx;
  color: #cccccc;
}